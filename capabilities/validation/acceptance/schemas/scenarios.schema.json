{
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeId",
    "timeoutSeconds",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runtimeId": {
      "type": "string",
      "minLength": 1
    },
    "timeoutSeconds": {
      "maximum": 60,
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "scenarios": {
      "items": {
        "additionalProperties": true,
        "required": [
          "id",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "expected": {
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "minProperties": 1,
            "type": "object"
          }
        },
        "type": "object"
      },
      "type": "array",
      "minItems": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object"
}
