{
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "loaded",
    "faulted",
    "artifactSha256",
    "sourceCommit"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "loaded": {
      "type": "boolean"
    },
    "faulted": {
      "type": "boolean"
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object"
}
