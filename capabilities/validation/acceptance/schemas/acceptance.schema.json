{
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactSha256",
    "sourceCommit",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "checks": {
      "items": {
        "additionalProperties": false,
        "required": [
          "id",
          "required",
          "status",
          "kind",
          "artifactSha256",
          "evidence"
        ],
        "properties": {
          "status": {
            "enum": [
              "passed",
              "failed",
              "unverified"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "automated",
              "runtime",
              "manual",
              "simulation"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{64}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "type": "object"
            }
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "artifactSha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        },
        "type": "object"
      },
      "type": "array",
      "minItems": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object"
}
