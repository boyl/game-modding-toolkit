{
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "canvas",
    "elements"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "elements": {
      "items": {
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "layer",
          "receivesInput",
          "rect",
          "textBounds"
        ],
        "properties": {
          "layer": {
            "type": "integer"
          },
          "kind": {
            "enum": [
              "content",
              "popup"
            ]
          },
          "rect": {
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "properties": {
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "y": {
                "type": "number"
              },
              "x": {
                "type": "number"
              }
            },
            "type": "object"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "textBounds": {
            "additionalProperties": false,
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "height": {
                "type": "number",
                "minimum": 0
              },
              "width": {
                "type": "number",
                "minimum": 0
              }
            },
            "type": "object"
          },
          "receivesInput": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "type": "array",
      "minItems": 1
    },
    "canvas": {
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object"
}
